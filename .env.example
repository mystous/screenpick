# screenpick 설정 예시. 셸에서 export 하거나 direnv 등으로 불러오세요.
SCREENPICK_TILE_WIDTH=60
SCREENPICK_TILE_HEIGHT=14
SCREENPICK_REFRESH_SEC=5
SCREENPICK_CAPTURE=pty
SCREENPICK_CAPTURE_TIMEOUT=1.5
SCREENPICK_WORKERS=6
SCREENPICK_ATTACHED_MODE=steal
SCREENPICK_RETURN_AFTER_DETACH=true
SCREENPICK_SINGLE_INSTANCE=true
SCREENPICK_SAFE_SYMBOLS=true
SCREENPICK_LOG_LEVEL=WARNING
# SCREENPICK_SCREEN_BIN=screen
# SCREENPICK_CLAUDE_DIR=~/.claude
# SCREENPICK_CODEX_DIR=~/.codex
